{
  "name": "edge-deployer",
  "version": "2.0.0",
  "description": "A unified desktop IDE for writing, testing, and deploying serverless edge functions.",
  "main": "build/electron/main.js",
  "author": "Mansoor Mamnoon <mansoormmamnoon@gmail.com>",
  "license": "ISC",
  "homepage": "https://github.com/mansoormmamnoon/edge-deployer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mansoormmamnoon/edge-deployer.git"
  },
  "scripts": {
    "start": "concurrently \"npm:tsc:watch\" \"npm:webpack:serve\" \"npm:electron\"",
    "tsc:watch": "tsc --watch",
    "webpack:serve": "webpack serve",
    "electron": "wait-on http://localhost:8080 && electron .",
    "build": "tsc && webpack",
    "build:prod": "cross-env NODE_ENV=production tsc && cross-env NODE_ENV=production webpack --mode production",
    "package": "npm run build:prod && electron-builder",
    "package:mac": "npm run build:prod && electron-builder --mac",
    "package:win": "npm run build:prod && electron-builder --win",
    "package:linux": "npm run build:prod && electron-builder --linux",
    "test": "jest --testPathPattern='src/__tests__|electron/__tests__'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently \"npm:webpack:serve\" \"npm:electron\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "serverless",
    "cloudflare-workers",
    "aws-lambda",
    "devtool",
    "edge-computing"
  ],
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.833.0",
    "@aws-sdk/client-sts": "^3.830.0",
    "axios": "^1.10.0",
    "dotenv": "^16.5.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2",
    "node-fetch": "^3.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts",
      "**/electron/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "monaco-editor": "<rootDir>/src/__mocks__/monaco-editor.ts",
      "\\.css$": "<rootDir>/src/__mocks__/styleMock.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "electron/*.ts",
      "src/cloudDeployers/**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 15000
  }
}
